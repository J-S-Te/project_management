PM_HTTP_ADDR=:8082

# 宿主机直接运行使用 MYSQL_DSN；Compose 使用下面两个密码构造容器内 DSN。
MYSQL_DSN=project:change-me@tcp(127.0.0.1:3306)/project_management?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
PROJECT_MYSQL_PASSWORD=
PROJECT_MYSQL_ROOT_PASSWORD=

TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=project-management
TEMPORAL_API_KEY=
TEMPORAL_TLS=false
PROJECT_RUN_WORKER_WITH_API=false

# 合同生效事件接收端。默认保留本地旧 Header 兼容；生产应设置为 true，
# 要求基础平台签发的应用 JWT。Client ID/Audience 是公开标识，
# 不含任何 Secret；合同系统的 Client Secret 只能保存在合同系统运行时配置中。
CONTRACT_INTEGRATION_ENABLED=false
CONTRACT_INTEGRATION_REQUIRE_BEARER=false
# 基础平台应用令牌契约：iss/aud、client_id、application_code、environment_code 和 scope 均严格绑定。
# 不要在此处填写 Client Secret；合同系统自行使用受控运行时 Secret 换取短期令牌。
CONTRACT_INTEGRATION_CLIENT_ID=contract_management-dev-project-integration
CONTRACT_INTEGRATION_AUDIENCE=basic-platform-application
CONTRACT_INTEGRATION_ISSUER=basic-platform
CONTRACT_INTEGRATION_PUBLIC_KEY_PATH=/app/data/keys/jwt-ed25519-public.pem
CONTRACT_INTEGRATION_CALLER_APPLICATION_CODE=contract_management
CONTRACT_INTEGRATION_CALLER_ENVIRONMENT_CODE=dev
CONTRACT_INTEGRATION_REQUIRED_SCOPE=project.contract.import

PLATFORM_BASE_URL=http://localhost:8080
# Compose 容器访问平台控制面使用该地址；OIDC 后通道单独配置，禁止混用。
PROJECT_PLATFORM_BACKCHANNEL_BASE_URL=http://platform-api:8080
# 项目 Compose 使用此变量覆盖通用 OIDC 后通道；必须与下面的值保持一致。
PROJECT_OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080
PLATFORM_APPLICATION_CODE=project_management
PLATFORM_ENVIRONMENT_CODE=dev
# 仅用于项目 Compose 将独立容器接入门户反向代理可达的外部网络；不由平台 Compose 管理。
PLATFORM_DOCKER_NETWORK=basic-platform-local_default

OIDC_ISSUER=http://localhost:18090/realms/basic-platform
# 容器端 OIDC Discovery/JWKS 走 Compose 内网；浏览器继续使用上面的公开 Issuer。
OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080
OIDC_CLIENT_ID=project_management-dev-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/project_management/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/project_management/logged-out
OIDC_TENANT_ID=
OIDC_SESSION_COOKIE_NAME=project_management_session
# 仅 localhost HTTP 开发环境可为 false；生产 HTTPS 必须设为 true。
OIDC_SESSION_COOKIE_SECURE=false
# 统一会话：空闲 30 分钟（60s~24h）+ 绝对 8 小时（必须大于空闲），鼠标/键盘活动
# 通过 POST /api/v1/auth/activity 续期；旧 OIDC_SESSION_TTL 仅在 ABSOLUTE 未设置时
# 作为绝对期限兼容，两个新键都设置时以新键为准。
OIDC_SESSION_IDLE_TTL=30m
OIDC_SESSION_ABSOLUTE_TTL=8h
# 中央模式下期限来自基础平台；完成所有RP升级后再启用。
CENTRAL_SESSION_ENABLED=false
CENTRAL_SESSION_PUBLIC_BASE_URL=
# Provisioner 自动生成；必须为随机 32 字节的 Base64，禁止提交真实值。
OIDC_AUTHORIZATION_REFRESH_INTERVAL=1m
OIDC_AUTHORIZATION_MAX_STALE=5m
OIDC_AUTHORIZATION_TIMEOUT=10s
# Provisioner 自动生成；必须为随机 32 字节的 Base64，禁止提交真实值。
OIDC_SESSION_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
APP_PATH_PREFIX=/project_management

# 以下两组机器客户端分别用于审计写入和授权目录同步，不能复用浏览器 OIDC Client。
PLATFORM_AUDIT_CLIENT_ID=
PLATFORM_AUDIT_CLIENT_SECRET=
# BIZ-XAPI-10：审计目的地是否必开。PROJECT_AUDIT_REQUIRED 优先（新键，显式 true/false），
# 其次兼容 PLATFORM_AUDIT_REQUIRED，最后 APP_ENV=production / PLATFORM_ENVIRONMENT_CODE=prod。
# 必开而凭据不全时 project-api 启动失败；非必开缺失只 WARN 并让 /readyz 降级。
PROJECT_AUDIT_REQUIRED=
PLATFORM_AUDIT_REQUIRED=false
# 通知目的地缺失不阻断非生产启动：WARN + /readyz degraded + 本地 outbox 积压；
# 生产（APP_ENV=production 或 PLATFORM_ENVIRONMENT_CODE=prod）下 NOTIFICATION_ENABLED=true
# 但缺少 URL/客户端凭据仍失败关闭。
NOTIFICATION_ENABLED=false
PLATFORM_NOTIFICATION_URL=http://platform-api:8080/api/v1/notifications/events
PLATFORM_NOTIFICATION_CLIENT_ID=
PLATFORM_NOTIFICATION_CLIENT_SECRET=
PLATFORM_NOTIFICATION_SCOPE=notification.ingest
PLATFORM_AUTHORIZATION_CATALOG_SYNC_ENABLED=true
PLATFORM_AUTHORIZATION_CATALOG_APPLICATION_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_ID=
PLATFORM_AUTHORIZATION_CATALOG_CLIENT_SECRET=

# 服务项操作台从基础平台负责人目录选择团队负责人、项目经理和工程师。
# 由 provisioner 按 owner_directory_read 单 scope 客户端下发；未开通时置 false。
OWNER_DIRECTORY_ENABLED=false
PLATFORM_OWNER_DIRECTORY_URL=http://platform-api:8080/api/v1/internal/owner-directory
PLATFORM_OWNER_DIRECTORY_SCOPE=owner_directory.read
PLATFORM_OWNER_DIRECTORY_CLIENT_ID=
PLATFORM_OWNER_DIRECTORY_CLIENT_SECRET=

# 人工新建项目只允许选择合同系统确认已通过审批的合同。
CONTRACT_APPROVAL_VALIDATION_ENABLED=false
CONTRACT_APPROVAL_VALIDATION_URL=http://contract-api:8081/internal/v1/project/approved-contracts
CONTRACT_APPROVAL_VALIDATION_SCOPE=contract.approved.internal.read
CONTRACT_APPROVAL_VALIDATION_CLIENT_ID=
CONTRACT_APPROVAL_VALIDATION_CLIENT_SECRET=

# 现场/偏离证据必须先上传统一文件网关并绑定服务项，业务事件只保存不可变回执。
FILE_GATEWAY_ENABLED=false
FILE_GATEWAY_BASE_URL=http://file-gateway:8086
FILE_GATEWAY_APPLICATION_ID=
FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind platform:file:download
FILE_GATEWAY_CLIENT_ID=
FILE_GATEWAY_CLIENT_SECRET=

# 数据分析 internal/dashboard 调用方契约。Keycloak 默认 service-account token 必须满足：
# iss=OIDC_ISSUER、azp/client_id=DASHBOARD_MACHINE_CLIENT_ID、aud 包含 DASHBOARD_MACHINE_AUDIENCE。
# tenant/application/environment 由服务端固定配置绑定，令牌中同名 claim 如存在必须一致。
# 使用 OIDC_ISSUER + OIDC_BACKCHANNEL_BASE_URL 做 Discovery/JWKS 验签；不使用平台 Ed25519 公钥。
DASHBOARD_MACHINE_ENABLED=false
DASHBOARD_MACHINE_REQUIRE_BEARER=false
DASHBOARD_MACHINE_CLIENT_ID=data_analysis-dev-project-dashboard
DASHBOARD_MACHINE_AUDIENCE=basic-platform-application

# 后台调度：新部署显式使用Temporal，旧运行文件缺省仍走legacy兼容路径。
PROJECT_BACKGROUND_ENGINE=temporal
PROJECT_BACKGROUND_TASK_QUEUE=project-management-background-v1
PROJECT_BACKGROUND_DEPLOYMENT_NAME=project-management-background
# Build由发布指针的完整不可变镜像摘要派生；禁止手填latest/pending。
PROJECT_BACKGROUND_BUILD_ID=
PROJECT_BACKGROUND_HEALTH_ADDRESS=127.0.0.1:9093
PROJECT_BACKGROUND_CONTROL_SOCKET=/tmp/project-background/control.sock
PROJECT_BACKGROUND_MAX_ITEMS=50
PROJECT_BACKGROUND_RUN_BUDGET=4m
PROJECT_BACKGROUND_ACTIVITY_TIMEOUT=55s
PROJECT_BACKGROUND_SLA_ACTIVITY_TIMEOUT=2m
PROJECT_BACKGROUND_WORKFLOW_RUN_TIMEOUT=6m
SLA_SCAN_INTERVAL=15m
NOTIFICATION_DISPATCH_INTERVAL=15s
# 完整项目投影的保护上限，只允许调低；批大小固定200。
PROJECT_SNAPSHOT_MAX_PROJECTS=50000
PROJECT_SNAPSHOT_MAX_SERVICE_ITEMS=250000
PROJECT_SNAPSHOT_MAX_BYTES=67108864
PROJECT_SNAPSHOT_MAX_LINE_BYTES=65536
PROJECT_SNAPSHOT_TIMEOUT=30s

# 结算项目引用：项目只校验平台签发的 Application JWT（issuer/audience/应用/环境/scope/公钥）。
# SETTLEMENT_REFERENCE_ALLOW_ANY_CLIENT=true 时不固定结算 client_id，client id 可为空，
# 结算先接入或项目先接入都可运行；生产清单即为该语义。false 时仍要求 client_id 精确匹配。
SETTLEMENT_REFERENCE_ENABLED=false
SETTLEMENT_REFERENCE_ALLOW_ANY_CLIENT=false
SETTLEMENT_REFERENCE_CLIENT_ID=
SETTLEMENT_REFERENCE_AUDIENCE=
SETTLEMENT_REFERENCE_ISSUER=
SETTLEMENT_REFERENCE_PUBLIC_KEY_PATH=
SETTLEMENT_REFERENCE_CALLER_ENVIRONMENT_CODE=prod

# 项目历史接续：关闭只阻止新命令；保留认证配置供精确重放和查询恢复。
PROJECT_CONTRACT_IMPORT_ENABLED=false
PROJECT_CONTRACT_IMPORT_CLIENT_ID=
PROJECT_CONTRACT_IMPORT_AUDIENCE=
PROJECT_CONTRACT_IMPORT_ISSUER=
PROJECT_CONTRACT_IMPORT_PUBLIC_KEY_PATH=
PROJECT_CONTRACT_IMPORT_CALLER_ENVIRONMENT_CODE=

# 现场签到：服务项带 site_code 时按站点坐标做球面距离校验。
# 超距/站点缺失/无坐标/停用按策略要求填写偏离原因；无 site_code 的历史项保持可签到。
PROJECT_FIELD_CHECKIN_DISTANCE_METERS=1000
PROJECT_FIELD_CHECKIN_SITE_MISSING_POLICY=REQUIRE_REASON
# 现场完成缺项说明门禁（BIZ-PROJECT-06）：缺项判定已下推服务端，按服务项完整事件流计算，
# 不再受"租户最近 500 条事件"窗口影响。enforce 拒绝两类矛盾叙述（证据不全却无说明 /
# 证据齐全却写说明），判定数据不可用时也拒绝完成；advisory 只记录不拒绝。
# 未配置即默认 advisory（存量部署安全默认）：旧前端的窗口误判不会与新后端门禁形成死锁。
# 发布顺序：先发本服务 → 再发前端 → 确认前端已用服务端判定后，显式设为 enforce。
# 全新部署如希望从第一天就硬约束，可直接取消下一行注释。
# FIELD_INCOMPLETE_REASON_GATE=enforce
# 固定接收 scope: project.contract.import；caller: contract_management。
